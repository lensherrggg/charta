  "numbering": {
    "heading": {
      "abstract_id": 1000,
      "num_id": 1000,
      "multi_level_type": "multilevel",
      "restart": {
        "enabled": true
      },
      "levels": [
        {
          "level": 0,
          "format": "chineseCounting",
          "text": "%1、",
          "start": 1,
          "indent_left_twips": 0,
          "first_line_twips": 640,
          "suffix": "nothing"
        },
        {
          "level": 1,
          "format": "chineseCounting",
          "text": "（%2）",
          "start": 1,
          "indent_left_twips": 0,
          "first_line_twips": 640,
          "suffix": "nothing"
        },
        {
          "level": 2,
          "format": "decimal",
          "text": "%3.",
          "start": 1,
          "indent_left_twips": 0,
          "first_line_twips": 640,
          "suffix": "space"
        },
        {
          "level": 3,
          "format": "decimal",
          "text": "（%4）",
          "start": 1,
          "indent_left_twips": 0,
          "first_line_twips": 640,
          "suffix": "nothing"
        }
      ]
    }
  },
